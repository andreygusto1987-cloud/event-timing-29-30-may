
    # === timing-blob proxy (CORS-обходка для GitHub Pages) ===
    location /timing-blob {
        if ($request_method = OPTIONS) {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, PUT, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type';
            return 204;
        }
        proxy_pass https://jsonblob.com/api/jsonBlob/019e5db4-e95d-77ff-8629-e0b03184fe65;
        proxy_set_header Host jsonblob.com;
        proxy_ssl_server_name on;
        proxy_method $request_method;
        proxy_pass_request_body on;
        proxy_pass_request_headers on;
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, PUT, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type' always;
    }

